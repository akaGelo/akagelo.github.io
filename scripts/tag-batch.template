export const meta = {
  name: 'tag-batch',
  description: 'Vision-тегирование батча фото: темы из набора + fits/suggest',
  phases: [{ title: 'Themes', detail: 'темы (1-3) + флаг «не вписывается»', model: '__MODEL__' }],
};

const ROOT = '/home/gelo/vyukov.ru';
const slugs = __SLUGS__;

const THEMES = ['street', 'portrait', 'landscape', 'animals', 'architecture', 'night'];
const SCHEMA = {
  type: 'object',
  additionalProperties: false,
  required: ['themes', 'fits'],
  properties: {
    themes: { type: 'array', minItems: 1, maxItems: 3, items: { type: 'string', enum: THEMES } },
    fits: { type: 'boolean' },
    suggest: { type: 'string' },
  },
};

function promptFor(img) {
  return (
    'Открой изображение инструментом Read: ' + img + '\n\n' +
    'Назначь 1-3 темы РОВНО из набора (предпочитай 1-2 самые определяющие, жанр + сюжет):\n' +
    'street (уличная сцена/жанр), portrait (портрет крупно), landscape (пейзаж/вид: море, поля, горы, природа),\n' +
    'animals (животные как объект), architecture (здания/сооружения), night (ночной город/ночная сцена).\n' +
    'Чёрно-белость НЕ указывай — её определю отдельно.\n' +
    'Также оцени fits: true если набор честно описывает кадр; false если заметно не вписывается —\n' +
    'тогда в suggest предложи ОДНО слово-тему (англ., нижний регистр). Верни строго через структурный вывод.'
  );
}

phase('Themes');
const results = await parallel(
  slugs.map((slug) => () =>
    agent(promptFor(ROOT + '/src/assets/photos/' + slug + '.jpg'), {
      label: 'theme:' + slug,
      phase: 'Themes',
      model: '__MODEL__',
      schema: SCHEMA,
    }).then((r) => (r ? { slug, themes: r.themes, fits: r.fits, suggest: r.suggest || '' } : null)),
  ),
);

const ok = results.filter(Boolean);
log('Темы: ' + ok.length + '/' + slugs.length + '; не вписались: ' + ok.filter((r) => r.fits === false).length);
return ok;
