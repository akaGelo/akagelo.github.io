export const meta = {
  name: 'tag-batch',
  description: 'Vision-тегирование батча фото (Sonnet): темы из набора + fits/suggest',
  phases: [{ title: 'Themes', detail: 'Sonnet: 1-3 темы + флаг «не вписывается»', model: 'sonnet' }],
};

const ROOT = '/home/gelo/vyukov.ru';
const slugs = __SLUGS__;

const THEMES = ['street', 'portrait', 'landscape', 'nature', 'animals', 'architecture', 'travel'];
const SCHEMA = {
  type: 'object',
  additionalProperties: false,
  required: ['themes', 'fits'],
  properties: {
    themes: { type: 'array', minItems: 1, maxItems: 3, items: { type: 'string', enum: THEMES } },
    fits: { type: 'boolean' },
    suggest: { type: 'string' },
  },
};

function promptFor(img) {
  return (
    'Открой изображение инструментом Read: ' + img + '\n\n' +
    'Назначь 1-3 темы РОВНО из набора: street, portrait, landscape, nature, animals, architecture, travel.\n' +
    'Предпочитай 1-2 самые определяющие (жанр + сюжет). Чёрно-белость НЕ указывай — её определю отдельно.\n' +
    'Также оцени: хорошо ли набор описывает кадр? fits=true если 1-2 темы честно отражают суть;\n' +
    'fits=false если заметно не вписывается (ночной город, макро, еда, спорт, абстракция, концерт, интерьер) —\n' +
    'тогда в suggest предложи ОДНО слово-тему (англ., нижний регистр). Верни строго через структурный вывод.'
  );
}

phase('Themes');
const results = await parallel(
  slugs.map((slug) => () =>
    agent(promptFor(ROOT + '/src/assets/photos/' + slug + '.jpg'), {
      label: 'theme:' + slug,
      phase: 'Themes',
      model: 'sonnet',
      schema: SCHEMA,
    }).then((r) => (r ? { slug, themes: r.themes, fits: r.fits, suggest: r.suggest || '' } : null)),
  ),
);

const ok = results.filter(Boolean);
log('Темы: ' + ok.length + '/' + slugs.length + '; не вписались: ' + ok.filter((r) => r.fits === false).length);
return ok;
